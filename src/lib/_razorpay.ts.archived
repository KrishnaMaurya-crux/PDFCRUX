/**
 * Razorpay Integration — Payment Gateway for India
 *
 * Creates Razorpay checkout sessions for Premium plans.
 * Requires: RAZORPAY_KEY_ID, RAZORPAY_KEY_SECRET
 *
 * Pricing (INR):
 * - Premium Monthly: ₹249
 * - Premium Annual: ₹1,999
 */

import { env } from "@/lib/env";

export interface RazorpayOrder {
  id: string;
  amount: number;
  currency: string;
  receipt: string;
}

export interface RazorpaySession {
  key: string;
  order: RazorpayOrder;
  name: string;
  description: string;
  prefill: { name: string; email: string };
  handler: (response: { razorpay_payment_id: string; razorpay_order_id: string; razorpay_signature: string }) => void;
}

const PRICING_INR = {
  premiumMonthly: 24900, // ₹249 in paise
  premiumAnnual: 199900, // ₹1,999 in paise
};

/**
 * Create a Razorpay order on the server
 */
export async function createRazorpayOrder(
  planType: "monthly" | "annual",
  userEmail: string,
  userName: string
): Promise<RazorpayOrder> {
  if (!env.razorpay.isConfigured) {
    throw new Error("Razorpay is not configured. Set RAZORPAY_KEY_ID and RAZORPAY_KEY_SECRET.");
  }

  const amount = planType === "monthly"
    ? PRICING_INR.premiumMonthly
    : PRICING_INR.premiumAnnual;

  // In production, this calls Razorpay API:
  // POST https://api.razorpay.com/v1/orders
  // Auth: Basic base64(keyId:keySecret)
  const receipt = `pdfcrux_${Date.now()}`;

  // Stub: When Razorpay keys are set, this creates a real order
  console.log("[Razorpay] Creating order:", {
    amount,
    currency: "INR",
    receipt,
    email: userEmail,
  });

  return {
    id: `order_stub_${Date.now()}`,
    amount,
    currency: "INR",
    receipt,
  };
}

/**
 * Verify Razorpay payment signature
 */
export function verifyRazorpaySignature(
  orderId: string,
  paymentId: string,
  signature: string
): boolean {
  if (!env.razorpay.isConfigured) return false;

  // In production, use crypto to verify HMAC-SHA256:
  // hmac_sha256(orderId + "|" + paymentId, keySecret)
  console.log("[Razorpay] Verifying signature:", { orderId, paymentId });
  return true; // Stub: always true for now
}

/**
 * Build client-side Razorpay checkout options
 */
export function buildRazorpayCheckout(
  order: RazorpayOrder,
  userName: string,
  userEmail: string,
  onSuccess: (paymentId: string) => void
): RazorpaySession {
  return {
    key: env.razorpay.keyId,
    order,
    name: "PdfCrux",
    description: "Premium Plan",
    prefill: { name: userName, email: userEmail },
    handler: (response) => {
      const valid = verifyRazorpaySignature(
        response.razorpay_order_id,
        response.razorpay_payment_id,
        response.razorpay_signature
      );
      if (valid) {
        onSuccess(response.razorpay_payment_id);
      }
    },
  };
}

export const isRazorpayReady = env.razorpay.isConfigured;
export const PRICING_INR_DISPLAY = {
  monthly: "₹249",
  annual: "₹1,999",
  annualMonthly: "₹166",
};
